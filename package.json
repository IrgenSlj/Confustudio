{
  "name": "confustudio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "confu/main.cjs",
  "description": "CONFUstudio — browser-first music studio with CONFUsynth as its flagship instrument.",
  "license": "Apache-2.0",
  "author": "IrgenSlj",
  "homepage": "https://github.com/IrgenSlj/Confustudio#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IrgenSlj/Confustudio.git"
  },
  "bugs": {
    "url": "https://github.com/IrgenSlj/Confustudio/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "music",
    "audio",
    "sequencer",
    "synthesizer",
    "daw",
    "web-audio",
    "audioworklet",
    "pwa",
    "midi",
    "sampler"
  ],
  "scripts": {
    "start": "node server.mjs",
    "dev": "node --watch server.mjs",
    "dev:vite": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "npm run lint && npm run test:types && npm run test:types:strict && npm run test:build && npm run test:syntax && npm run test:kernel && npm run test:score && npm run test:perception && npm run test:spectrum && npm run test:harness && npm run test:loop && npm run test:branch && npm run test:state && npm run test:project-v4 && npm run test:commands && npm run test:baseline && npm run test:security && npm run test:boundaries && npm run test:server && npm run test:ui-smoke",
    "test:types": "tsc -p jsconfig.json",
    "test:types:strict": "tsc -p tsconfig.strict.json",
    "test:perception": "node tests/loudness.mjs",
    "test:spectrum": "node tests/spectrum.mjs",
    "test:syntax": "node tests/syntax-check.mjs",
    "test:build": "node tests/build-output.mjs",
    "test:kernel": "node tests/kernel-event-compiler.mjs",
    "test:score": "node tests/score-roundtrip.mjs",
    "test:harness": "node tests/harness-tools.mjs",
    "test:loop": "node tests/harness-loop.mjs",
    "test:state": "node tests/state-commands.mjs && node tests/persistence-status.mjs",
    "test:project-v4": "node tests/project-v4.mjs",
    "test:commands": "node tests/command-reducer.mjs && node tests/command-history.mjs",
    "test:server": "node tests/server-routes.mjs",
    "test:baseline": "node tests/baseline-fixtures.mjs && node tests/assistant-proxy-gate.mjs",
    "test:security": "node tests/provider-policy.mjs && node tests/provider-egress.mjs && node tests/assistant-abuse-controls.mjs",
    "test:boundaries": "node tests/trust-boundaries.mjs && node tests/browser-boundaries.mjs",
    "test:ui-smoke": "node tests/ui-smoke.mjs",
    "baseline": "node scripts/measure-baseline.mjs",
    "audit:deps": "npm audit --audit-level=high",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "confu": "electron .",
    "confu:dev": "ELECTRON_IS_DEV=1 electron .",
    "test:branch": "node tests/harness-branch.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "electron": "^41.3.0",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.6.0",
    "playwright": "^1.59.1",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3",
    "vite": "^7.3.6"
  }
}
